* text=auto

# Formatter-supported text stays byte-stable across Windows, macOS, and CI.
.editorconfig text eol=lf
.gitattributes text eol=lf
.prettierignore text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
